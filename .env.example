# FinRAG configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Real shell environment variables override these. `.env` is gitignored; never
# commit your real keys. Everything here has a sensible default EXCEPT the
# LLM API key, which you must provide for live answers.

# === LLM (required for answering) ===========================================
# Which backend builds the chat model: "openrouter" or "ollama".
LLM_PROVIDER=openrouter

# OpenRouter (OpenAI-compatible). Get a key at https://openrouter.ai/keys.
# REQUIRED when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Any chat/instruct model slug from https://openrouter.ai/models.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama (used only when LLM_PROVIDER=ollama).
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_BASE_URL=http://localhost:11434

# === Domain pack ============================================================
# Folder under packs/ holding the corpus-specific config (companies, fiscal
# calendar, metrics, currencies, prompts). Ships with "finance-india".
DOMAIN_PACK=finance-india

# === Cache (optional) =======================================================
# Redis L1 cache for extracted facts. Falls back to SQLite if unreachable.
# Set empty to disable Redis entirely.
REDIS_URL=redis://localhost:6379/0

# === Django ================================================================
# Generate a fresh secret for any non-local deployment:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Turn OFF (False) for anything public-facing.
DJANGO_DEBUG=True
# Comma-separated hosts allowed to serve the app, e.g. localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
